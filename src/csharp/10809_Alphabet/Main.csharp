class Program {
    static void Main(string[] args) {
        FirstUniqChar(Console.ReadLine());
    }

    int FirstUniqChar(string s) {
    var cnt = new int[26];
    foreach (var ch in s) cnt[ch - 'a']++;
    for (int i = 0; i < s.Length; i++)
        if (cnt[s[i] - 'a'] == 1) return i;
    return -1;
}
}